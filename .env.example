# Backend (copy to backend/.env)
ARCHFLOW_CORS_ORIGINS=http://localhost:3000
ARCHFLOW_MAX_UPLOAD_MB=15
# ARCHFLOW_STORAGE_DIR=./storage

# Mode. development (default): answers only this computer. production: serves the network, needs sign-in below.
# ARCHFLOW_ENV=production

# Developer sign-in (README "Sign-in"). Required with ARCHFLOW_ENV=production; leave empty for local use.
# ARCHFLOW_ADMIN_PASSWORD_HASH=   (output of: python -m app.security.passwd; never commit it)
# ARCHFLOW_SESSION_SECRET=        (32+ random characters; never commit it)
# ARCHFLOW_SESSION_HOURS=12
# ARCHFLOW_COOKIE_SECURE=         (default: on in production; false is refused there)

# Request limits (default: on in production, where false is refused; off in development) and processing caps.
# ARCHFLOW_RATE_LIMITS=
# ARCHFLOW_RATE_UPLOAD_PER_MINUTE=10
# ARCHFLOW_RATE_UPLOAD_PER_DAY=60
# ARCHFLOW_RATE_INTERPRET_PER_MINUTE=6
# ARCHFLOW_RATE_WRITE_PER_MINUTE=120
# ARCHFLOW_RATE_LOGIN_PER_MINUTE=5
# ARCHFLOW_RATE_LOGIN_GLOBAL_PER_MINUTE=30
# ARCHFLOW_MAX_CONCURRENT_UPLOADS=2
# ARCHFLOW_MAX_CONCURRENT_INTERPRETATIONS=1
# ARCHFLOW_MAX_CONCURRENT_LOGINS=2

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
